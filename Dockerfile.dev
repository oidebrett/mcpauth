# ----------------------
# Dev stage with Air + CGO + glibc
# ----------------------
FROM golang:1.25 AS dev

# Install build dependencies for CGO and sqlite
RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    g++ \
    libc6-dev \
    sqlite3 \
    libsqlite3-dev \
    git \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Air (hot reload)
RUN go install github.com/cosmtrek/air@latest

# Copy go.mod first and download deps (cache layer)
COPY go.mod go.sum ./
RUN go mod download

# Copy the source (bind mount will overwrite this in dev)
COPY . .

# Default command → run Air for live reload
CMD ["air"]
